{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a1-ouinp.local/schemas/hpc-job-request.schema.json",
  "title": "A1 OUinp tracked HPC job request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "job_kind",
    "target",
    "template_path",
    "expected_result_path",
    "completion_files",
    "top_level_resources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "$ref": "#/$defs/name"
    },
    "job_kind": {
      "enum": [
        "single",
        "batch",
        "workflow"
      ]
    },
    "target": {
      "$ref": "#/$defs/repoPath"
    },
    "template_path": {
      "type": "string",
      "pattern": "^hpc_jobs/templates/[A-Za-z0-9][A-Za-z0-9_.+-]*\\.sh$"
    },
    "expected_result_path": {
      "type": "string",
      "pattern": "^exp_results/[A-Za-z0-9][A-Za-z0-9_.+/-]*$"
    },
    "completion_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repoPath"
      }
    },
    "top_level_resources": {
      "$ref": "#/$defs/resources"
    },
    "simulation_job_resources": {
      "$ref": "#/$defs/resources"
    },
    "max_concurrent_simulation_jobs": {
      "$ref": "#/$defs/positiveInteger"
    },
    "max_simulation_jobs": {
      "$ref": "#/$defs/positiveInteger"
    },
    "stage_jobs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resources",
          "max_concurrent_simulation_jobs"
        ],
        "properties": {
          "resources": {
            "$ref": "#/$defs/resources"
          },
          "max_concurrent_simulation_jobs": {
            "$ref": "#/$defs/positiveInteger"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "job_kind": {
          "const": "single"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "simulation_job_resources"
            ]
          },
          {
            "required": [
              "max_concurrent_simulation_jobs"
            ]
          },
          {
            "required": [
              "max_simulation_jobs"
            ]
          },
          {
            "required": [
              "stage_jobs"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "job_kind": {
          "const": "batch"
        }
      },
      "required": [
        "simulation_job_resources",
        "max_concurrent_simulation_jobs",
        "max_simulation_jobs"
      ],
      "not": {
        "required": [
          "stage_jobs"
        ]
      }
    },
    {
      "properties": {
        "job_kind": {
          "const": "workflow"
        }
      },
      "required": [
        "stage_jobs",
        "max_simulation_jobs"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "simulation_job_resources"
            ]
          },
          {
            "required": [
              "max_concurrent_simulation_jobs"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "repoPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+/-]{0,511}$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition",
        "nodes",
        "cores",
        "memory_gb",
        "wall_time_min"
      ],
      "properties": {
        "partition": {
          "$ref": "#/$defs/name"
        },
        "nodes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "cores": {
          "$ref": "#/$defs/positiveInteger"
        },
        "memory_gb": {
          "$ref": "#/$defs/positiveInteger"
        },
        "wall_time_min": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    }
  }
}
