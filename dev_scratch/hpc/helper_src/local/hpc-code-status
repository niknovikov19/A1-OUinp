#!/usr/bin/env python3
import argparse
import json
from pathlib import Path
import shlex
import subprocess
import sys

sys.dont_write_bytecode = True

from hpc_common import (
    EXIT_FAILED,
    EXIT_SUCCESS,
    EXIT_UNKNOWN,
    HelperFailure,
    append_audit_event,
    get_config_identity,
    load_config,
)


SSH_PATH = '/usr/bin/ssh'
MAX_REMOTE_BYTES = 65536


class RemoteUnavailable(RuntimeError):
    """Represent an unavailable or invalid remote status response."""


def build_parser():
    """Build the fixed code-status parser."""
    parser = argparse.ArgumentParser(
        description='Inspect the fixed HPC automation checkout.',
    )
    parser.add_argument(
        '--json',
        action='store_true',
        help='Print structured JSON instead of a concise summary.',
    )
    return parser


def build_ssh_command(config):
    """Build the one allowlisted remote code-status invocation."""
    helper = Path(config['remote_helpers']['lethe_dir']) / 'hpc-lethe-code'
    remote_command = ' '.join((shlex.quote(helper.as_posix()), 'status'))
    timeout = config['ssh']['connect_timeout_sec']
    return [
        SSH_PATH,
        '-o',
        'BatchMode=yes',
        '-o',
        f'ConnectTimeout={timeout}',
        '-o',
        'ConnectionAttempts=1',
        '--',
        config['ssh']['lethe_host_alias'],
        remote_command,
    ]


def decode_bounded(value, label):
    """Decode one bounded UTF-8 subprocess stream."""
    if len(value) > MAX_REMOTE_BYTES:
        raise RemoteUnavailable(f'{label} exceeded {MAX_REMOTE_BYTES} bytes')
    try:
        return value.decode('utf-8')
    except UnicodeDecodeError as exc:
        raise RemoteUnavailable(f'{label} was not valid UTF-8') from exc


def summarize_stderr(value):
    """Return a bounded single-line SSH error summary."""
    summary = value.replace('\r', ' ').replace('\n', ' ').strip()
    return summary[:500] if summary else 'no error details'


def unknown_result(reason, details=None):
    """Build one structured unknown status result."""
    result = {
        'schema_version': 1,
        'operation': 'code-status',
        'status': 'unknown',
        'reason': reason,
    }
    if details:
        result['details'] = str(details)[:500]
    return result


def parse_remote_result(stdout):
    """Parse and minimally validate the remote status object."""
    try:
        result = json.loads(stdout)
    except json.JSONDecodeError as exc:
        raise RemoteUnavailable('Remote status was not valid JSON') from exc
    valid = (
        isinstance(result, dict) and
        result.get('operation') == 'code-status' and
        result.get('status') in {'ok', 'unknown', 'failed'}
    )
    if not valid:
        raise RemoteUnavailable('Remote status object was invalid')
    if result['status'] == 'ok' and not isinstance(
        result.get('checkout'),
        dict,
    ):
        raise RemoteUnavailable('Remote status omitted checkout state')
    return result


def run_status(config):
    """Run the fixed remote status command and normalize its exit state."""
    command = build_ssh_command(config)
    timeout = config['ssh']['connect_timeout_sec'] + 20
    try:
        completed = subprocess.run(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return unknown_result('connection-timeout'), EXIT_UNKNOWN
    except OSError as exc:
        return unknown_result('ssh-unavailable', exc), EXIT_UNKNOWN

    try:
        stdout = decode_bounded(completed.stdout, 'Remote stdout')
        stderr = decode_bounded(completed.stderr, 'Remote stderr')
        result = parse_remote_result(stdout)
    except RemoteUnavailable as exc:
        details = summarize_stderr(
            completed.stderr.decode('utf-8', errors='replace')
        )
        return unknown_result(str(exc), details), EXIT_UNKNOWN

    expected = {
        EXIT_SUCCESS: 'ok',
        EXIT_UNKNOWN: 'unknown',
        EXIT_FAILED: 'failed',
    }
    if expected.get(completed.returncode) != result['status']:
        details = summarize_stderr(stderr)
        return unknown_result('inconsistent-remote-result', details), EXIT_UNKNOWN
    result['local_config_sha256'] = get_config_identity(config)
    return result, completed.returncode


def audit_or_fail(status, exit_code, raw_args, details=None):
    """Write one mandatory local code-status audit event."""
    try:
        append_audit_event(
            'code-status',
            status,
            exit_code,
            raw_args,
            details=details,
            helper='hpc-code-status',
        )
    except HelperFailure as exc:
        print(f'Audit failure: {exc}', file=sys.stderr)
        return False
    return True


def print_result(result, as_json):
    """Print one structured or concise checkout status."""
    if as_json:
        print(json.dumps(result, indent=2, sort_keys=True))
        return
    print(f'Status: {result["status"]}')
    if result['status'] != 'ok':
        print(f'Reason: {result["reason"]}')
        return
    checkout = result['checkout']
    print(f'Branch: {checkout["branch"]}')
    print(f'Commit: {checkout["commit"]}')
    print(f'Clean: {checkout["clean"]}')
    print(f'Update lock active: {checkout["update_lock_active"]}')
    print(f'Active run: {checkout["active_run"]}')


def main():
    """Run the protected A2 checkout-status command."""
    raw_args = sys.argv[1:]
    parser = build_parser()
    try:
        args = parser.parse_args(raw_args)
    except SystemExit as exc:
        exit_code = int(exc.code)
        status = 'success' if exit_code == 0 else 'rejected'
        if not audit_or_fail(status, exit_code, raw_args):
            return EXIT_FAILED
        return exit_code

    try:
        config = load_config()
        result, exit_code = run_status(config)
    except HelperFailure as exc:
        if not audit_or_fail('failed', EXIT_FAILED, raw_args, type(exc).__name__):
            return EXIT_FAILED
        print(f'Failed: {exc}', file=sys.stderr)
        return EXIT_FAILED

    status = result['status']
    status = 'success' if status == 'ok' else status
    if not audit_or_fail(status, exit_code, raw_args, result.get('reason')):
        return EXIT_FAILED
    print_result(result, args.json)
    return exit_code


if __name__ == '__main__':
    raise SystemExit(main())
