#!/usr/bin/env python3
import argparse
import json
from pathlib import Path
import shlex
import subprocess
import sys

sys.dont_write_bytecode = True

from hpc_common import (
    EXIT_FAILED,
    EXIT_REJECTED,
    EXIT_SUCCESS,
    EXIT_UNKNOWN,
    HelperFailure,
    RejectedInput,
    append_audit_event,
    get_config_identity,
    load_config,
    validate_git_commit,
    validate_request_id,
    validate_run_id,
)


SSH_PATH = '/usr/bin/ssh'
HELPER_VERSION = '0.8.0-b0'
MAX_REMOTE_BYTES = 131072
REMOTE_TIMEOUT_SEC = 60


class RemoteUnavailable(RuntimeError):
    """Represent an unavailable or inconsistent remote preparation result."""


def build_parser():
    """Build the fixed job-preparation parser."""
    parser = argparse.ArgumentParser(
        description='Prepare one reviewed repository job without submitting it.',
    )
    parser.add_argument('--json', action='store_true')
    parser.add_argument('--version', action='version', version=HELPER_VERSION)
    parser.add_argument('request_id')
    parser.add_argument('run_id')
    parser.add_argument('expected_commit')
    return parser


def build_ssh_command(config, request_id, run_id, expected_commit):
    """Build the one allowlisted lethe preparation invocation."""
    helper = Path(config['remote_helpers']['lethe_dir']) / 'hpc-lethe-prepare'
    remote_command = ' '.join((
        shlex.quote(helper.as_posix()),
        'prepare',
        shlex.quote(request_id),
        shlex.quote(run_id),
        shlex.quote(expected_commit),
    ))
    timeout = config['ssh']['connect_timeout_sec']
    return [
        SSH_PATH,
        '-o',
        'BatchMode=yes',
        '-o',
        f'ConnectTimeout={timeout}',
        '-o',
        'ConnectionAttempts=1',
        '--',
        config['ssh']['lethe_host_alias'],
        remote_command,
    ]


def decode_bounded(value, label):
    """Decode one bounded remote UTF-8 stream."""
    if len(value) > MAX_REMOTE_BYTES:
        raise RemoteUnavailable(f'{label} exceeded {MAX_REMOTE_BYTES} bytes')
    try:
        return value.decode('utf-8')
    except UnicodeDecodeError as exc:
        raise RemoteUnavailable(f'{label} was not valid UTF-8') from exc


def parse_remote_result(stdout):
    """Parse and minimally validate one remote preparation result."""
    try:
        result = json.loads(stdout)
    except json.JSONDecodeError as exc:
        raise RemoteUnavailable('Remote preparation was not valid JSON') from exc
    valid = (
        isinstance(result, dict) and
        result.get('operation') == 'job-prepare' and
        result.get('status') in {'ok', 'rejected', 'failed'}
    )
    if not valid:
        raise RemoteUnavailable('Remote preparation object was invalid')
    return result


def error_result(status, reason, details=None):
    """Build one structured non-success preparation result."""
    result = {
        'schema_version': 1,
        'operation': 'job-prepare',
        'status': status,
        'reason': reason,
    }
    if details:
        result['details'] = str(details)[:500]
    return result


def run_prepare(config, request_id, run_id, expected_commit):
    """Invoke the fixed remote preparation helper once."""
    command = build_ssh_command(
        config,
        request_id,
        run_id,
        expected_commit,
    )
    try:
        completed = subprocess.run(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=REMOTE_TIMEOUT_SEC,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return error_result('unknown', 'operation-timeout'), EXIT_UNKNOWN
    except OSError as exc:
        return error_result('unknown', 'ssh-unavailable', exc), EXIT_UNKNOWN

    try:
        stdout = decode_bounded(completed.stdout, 'Remote stdout')
        stderr = decode_bounded(completed.stderr, 'Remote stderr')
        result = parse_remote_result(stdout)
    except RemoteUnavailable as exc:
        details = completed.stderr.decode('utf-8', errors='replace')
        return error_result('unknown', str(exc), details), EXIT_UNKNOWN
    expected = {
        EXIT_SUCCESS: 'ok',
        EXIT_REJECTED: 'rejected',
        EXIT_FAILED: 'failed',
    }
    if expected.get(completed.returncode) != result['status']:
        details = stderr.replace('\r', ' ').replace('\n', ' ').strip()[:500]
        return error_result(
            'unknown',
            'inconsistent-remote-result',
            details,
        ), EXIT_UNKNOWN
    result['local_config_sha256'] = get_config_identity(config)
    return result, completed.returncode


def audit_or_fail(status, exit_code, raw_args, details=None):
    """Write one mandatory local job-preparation audit event."""
    try:
        append_audit_event(
            'job-prepare',
            status,
            exit_code,
            raw_args,
            details=details,
            helper='hpc-job-prepare',
        )
    except HelperFailure as exc:
        print(f'Audit failure: {exc}', file=sys.stderr)
        return False
    return True


def print_result(result, as_json):
    """Print one structured or concise preparation result."""
    if as_json:
        print(json.dumps(result, indent=2, sort_keys=True))
        return
    print(f'Status: {result["status"]}')
    if result['status'] != 'ok':
        print(f'Reason: {result["reason"]}')
        return
    prepared = result['prepared']
    print(f'Result: {prepared["result"]}')
    print(f'Request: {prepared["request_id"]}')
    print(f'Run: {prepared["run_id"]}')
    print(f'Commit: {prepared["git_commit"]}')
    print(f'Job kind: {prepared["job_kind"]}')
    print(f'Expected result: {prepared["expected_result_path"]}')
    print(f'Submit script: {prepared["submit_script"]}')
    print(f'Script SHA256: {prepared["rendered_script_sha256"]}')


def main():
    """Run the protected local B0 preparation command."""
    raw_args = sys.argv[1:]
    parser = build_parser()
    try:
        args = parser.parse_args(raw_args)
    except SystemExit as exc:
        exit_code = int(exc.code)
        status = 'success' if exit_code == 0 else 'rejected'
        if not audit_or_fail(status, exit_code, raw_args):
            return EXIT_FAILED
        return exit_code

    try:
        request_id = validate_request_id(args.request_id)
        run_id = validate_run_id(args.run_id)
        commit = validate_git_commit(args.expected_commit)
        config = load_config()
    except RejectedInput as exc:
        if not audit_or_fail('rejected', EXIT_REJECTED, raw_args, exc):
            return EXIT_FAILED
        print(f'Rejected: {exc}', file=sys.stderr)
        return EXIT_REJECTED
    except HelperFailure as exc:
        if not audit_or_fail('failed', EXIT_FAILED, raw_args, type(exc).__name__):
            return EXIT_FAILED
        print(f'Failed: {exc}', file=sys.stderr)
        return EXIT_FAILED

    result, exit_code = run_prepare(config, request_id, run_id, commit)
    status = 'success' if result['status'] == 'ok' else result['status']
    if not audit_or_fail(
        status,
        exit_code,
        raw_args,
        result.get('reason') or result.get('prepared', {}).get('result'),
    ):
        return EXIT_FAILED
    print_result(result, args.json)
    return exit_code


if __name__ == '__main__':
    raise SystemExit(main())
