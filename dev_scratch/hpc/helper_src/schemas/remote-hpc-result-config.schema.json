{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a1-ouinp.local/schemas/remote-hpc-result-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment_id",
    "git",
    "runs",
    "state",
    "artifact_types",
    "limits"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "deployment_id": {"$ref": "#/$defs/safeName"},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automation_checkout"],
      "properties": {
        "automation_checkout": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "runs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {"root": {"$ref": "#/$defs/absolutePath"}}
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "inventory_dir", "result_lock"],
      "properties": {
        "root": {"$ref": "#/$defs/absolutePath"},
        "inventory_dir": {"$ref": "#/$defs/absolutePath"},
        "result_lock": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "artifact_types": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^\\.[A-Za-z0-9]+$"}
      },
      "minProperties": 1
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_artifacts",
        "max_transfer_bytes",
        "checksum_max_bytes"
      ],
      "properties": {
        "max_artifacts": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_transfer_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "checksum_max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    }
  },
  "$defs": {
    "safeName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/[^\\u0000]*$"
    }
  }
}
