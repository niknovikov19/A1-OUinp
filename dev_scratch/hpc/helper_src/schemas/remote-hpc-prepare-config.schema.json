{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a1-ouinp.local/schemas/remote-hpc-prepare-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment_id",
    "git",
    "runs",
    "state",
    "preparation",
    "scheduler"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "deployment_id": {
      "$ref": "#/$defs/name"
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "automation_checkout",
        "branch"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "automation_checkout": {
          "$ref": "#/$defs/absolutePath"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "runs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/absolutePath"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prepare_lock",
        "run_records"
      ],
      "properties": {
        "prepare_lock": {
          "$ref": "#/$defs/absolutePath"
        },
        "run_records": {
          "$ref": "#/$defs/absolutePath"
        }
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_request_bytes",
        "max_template_bytes",
        "allowed_templates"
      ],
      "properties": {
        "max_request_bytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "max_template_bytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "allowed_templates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "single",
            "batch",
            "workflow"
          ],
          "properties": {
            "single": {
              "$ref": "#/$defs/template"
            },
            "batch": {
              "$ref": "#/$defs/template"
            },
            "workflow": {
              "$ref": "#/$defs/template"
            }
          }
        }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_partitions",
        "limits"
      ],
      "properties": {
        "allowed_partitions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_child_jobs",
            "max_concurrent_jobs",
            "max_cores_per_job",
            "max_memory_gb_per_job",
            "max_nodes_per_job",
            "max_wall_time_min"
          ],
          "properties": {
            "max_child_jobs": {
              "$ref": "#/$defs/positiveInteger"
            },
            "max_concurrent_jobs": {
              "$ref": "#/$defs/positiveInteger"
            },
            "max_cores_per_job": {
              "$ref": "#/$defs/positiveInteger"
            },
            "max_memory_gb_per_job": {
              "$ref": "#/$defs/positiveInteger"
            },
            "max_nodes_per_job": {
              "$ref": "#/$defs/positiveInteger"
            },
            "max_wall_time_min": {
              "$ref": "#/$defs/positiveInteger"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/[^\\u0000]*$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^hpc_jobs/templates/(single|batch|workflow)\\.sh$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
