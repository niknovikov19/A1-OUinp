{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/a1-hpc/run.schema.json",
  "title": "A1 HPC automation run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "request_id",
    "request_sha256",
    "branch",
    "git_commit",
    "run_type",
    "experiment",
    "created_at_utc",
    "status",
    "calculated_child_jobs",
    "max_concurrent_jobs",
    "resources",
    "expected_result_dir"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "helper_bundle_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "run_type": {
      "enum": [
        "probe",
        "single",
        "batch"
      ]
    },
    "experiment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}(/[A-Za-z0-9][A-Za-z0-9_.-]{0,63})*$"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "submitted_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "prepared",
        "submitted",
        "running",
        "complete",
        "failed",
        "cancelled",
        "unknown"
      ]
    },
    "controller_slurm_id": {
      "type": "integer",
      "minimum": 1
    },
    "child_slurm_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "calculated_child_jobs": {
      "type": "integer",
      "minimum": 1
    },
    "max_concurrent_jobs": {
      "type": "integer",
      "minimum": 1
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition",
        "nodes",
        "cores",
        "memory_gb",
        "wall_time_min"
      ],
      "properties": {
        "partition": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "integer",
          "minimum": 1
        },
        "cores": {
          "type": "integer",
          "minimum": 1
        },
        "memory_gb": {
          "type": "integer",
          "minimum": 1
        },
        "wall_time_min": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "expected_result_dir": {
      "type": "string",
      "pattern": "^/[^\\u0000]*$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

