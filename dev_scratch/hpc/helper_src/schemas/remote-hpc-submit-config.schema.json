{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/a1-hpc/remote-hpc-submit-config.schema.json",
  "title": "A1 HPC fixed submission configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment_id",
    "ssh",
    "remote_helpers",
    "runs",
    "state",
    "scheduler",
    "submission"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "deployment_id": {
      "$ref": "#/$defs/safe_name"
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grid_host_alias",
        "connect_timeout_sec"
      ],
      "properties": {
        "grid_host_alias": {
          "$ref": "#/$defs/safe_name"
        },
        "connect_timeout_sec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      }
    },
    "remote_helpers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lethe_preview",
        "grid_submit",
        "grid_probe_job"
      ],
      "properties": {
        "lethe_preview": {
          "$ref": "#/$defs/absolute_path"
        },
        "grid_submit": {
          "$ref": "#/$defs/absolute_path"
        },
        "grid_probe_job": {
          "$ref": "#/$defs/absolute_path"
        }
      }
    },
    "runs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/absolute_path"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submit_lock"
      ],
      "properties": {
        "submit_lock": {
          "$ref": "#/$defs/absolute_path"
        }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user",
        "account",
        "sbatch_path",
        "partition",
        "resources"
      ],
      "properties": {
        "user": {
          "$ref": "#/$defs/safe_name"
        },
        "account": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/$defs/safe_name"
            }
          ]
        },
        "sbatch_path": {
          "$ref": "#/$defs/absolute_path"
        },
        "partition": {
          "$ref": "#/$defs/safe_name"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_request_ids",
        "allowed_run_type",
        "allowed_output_kind",
        "job_name_prefix",
        "max_request_bytes",
        "probe_job_sha256"
      ],
      "properties": {
        "allowed_request_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safe_name"
          }
        },
        "allowed_run_type": {
          "const": "probe"
        },
        "allowed_output_kind": {
          "const": "marker"
        },
        "job_name_prefix": {
          "$ref": "#/$defs/safe_name"
        },
        "max_request_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072
        },
        "probe_job_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "safe_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "absolute_path": {
      "type": "string",
      "pattern": "^/[^\\u0000]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "cores",
        "memory_gb",
        "wall_time_min"
      ],
      "properties": {
        "nodes": {
          "type": "integer",
          "minimum": 1
        },
        "cores": {
          "type": "integer",
          "minimum": 1
        },
        "memory_gb": {
          "type": "integer",
          "minimum": 1
        },
        "wall_time_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 59
        }
      }
    }
  }
}
