{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/a1-hpc/remote-hpc-code-config.schema.json",
  "title": "A2 remote Git helper configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment_id",
    "git",
    "state"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "deployment_id": {
      "$ref": "#/$defs/safeName"
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "automation_checkout",
        "branch",
        "remote_name"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "automation_checkout": {
          "$ref": "#/$defs/absolutePath"
        },
        "branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        "remote_name": {
          "$ref": "#/$defs/safeName"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/absolutePath"
        }
      }
    }
  },
  "$defs": {
    "safeName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/[^\\u0000]*$"
    }
  }
}
