import argparse
import hashlib
import json
from pathlib import Path
import re
import shlex
import socket
import stat
import subprocess


HELPER_VERSION = '0.2.0-a1'
EXIT_SUCCESS = 0
EXIT_UNKNOWN = 3

SSH_PATH = '/usr/bin/ssh'
MAX_REMOTE_BYTES = 65536
SAFE_NAME_RE = re.compile(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,63}')


class ProbeFailure(RuntimeError):
    """Represent a known remote-helper failure."""


def get_common_root():
    """Return the fixed shared helper root derived from this script."""
    return Path(__file__).resolve().parents[2]


def get_config_path():
    """Return the fixed shared remote configuration path."""
    return get_common_root() / 'config' / 'A1_OUinp.json'


def canonical_json(value):
    """Serialize JSON deterministically for hashing."""
    return json.dumps(value, sort_keys=True, separators=(',', ':'))


def hash_bytes(value):
    """Return a SHA256 digest for bytes."""
    return hashlib.sha256(value).hexdigest()


def helper_identity():
    """Return the installed lethe-helper version and source hash."""
    fpath = Path(__file__).resolve()
    return {
        'name': 'hpc-lethe-probe',
        'version': HELPER_VERSION,
        'source_sha256': hash_bytes(fpath.read_bytes()),
    }


def require_mapping(value, label):
    """Return a mapping or reject it."""
    if not isinstance(value, dict):
        raise ProbeFailure(f'{label} must be an object')
    return value


def require_exact_keys(value, required, label):
    """Reject missing or unknown configuration keys."""
    missing = sorted(set(required) - set(value))
    unknown = sorted(set(value) - set(required))
    if missing:
        raise ProbeFailure(f'{label} is missing keys: {missing}')
    if unknown:
        raise ProbeFailure(f'{label} has unknown keys: {unknown}')


def validate_safe_name(value, label):
    """Validate one shell-inert configuration name."""
    if not isinstance(value, str) or SAFE_NAME_RE.fullmatch(value) is None:
        raise ProbeFailure(f'Invalid {label}')
    return value


def validate_absolute_path(value, label):
    """Validate one normalized absolute POSIX path."""
    if not isinstance(value, str) or not value:
        raise ProbeFailure(f'{label} must be a non-empty string')
    fpath = Path(value)
    if not fpath.is_absolute() or '..' in fpath.parts:
        raise ProbeFailure(f'{label} must be an absolute normalized path')
    if value != fpath.as_posix():
        raise ProbeFailure(f'{label} must use normalized POSIX syntax')
    return value


def validate_config(config):
    """Validate the complete fixed remote-probe configuration."""
    config = require_mapping(config, 'configuration')
    required = {
        'deployment_id',
        'git',
        'remote_helpers',
        'scheduler',
        'schema_version',
        'ssh',
    }
    require_exact_keys(config, required, 'configuration')
    if config['schema_version'] != 1:
        raise ProbeFailure('Unsupported remote configuration schema')
    validate_safe_name(config['deployment_id'], 'deployment ID')

    git = require_mapping(config['git'], 'git')
    require_exact_keys(git, {'automation_checkout'}, 'git')
    validate_absolute_path(git['automation_checkout'], 'automation checkout')

    ssh = require_mapping(config['ssh'], 'ssh')
    require_exact_keys(ssh, {'connect_timeout_sec', 'grid_host_alias'}, 'ssh')
    validate_safe_name(ssh['grid_host_alias'], 'grid host alias')
    timeout = ssh['connect_timeout_sec']
    if isinstance(timeout, bool) or not isinstance(timeout, int):
        raise ProbeFailure('Connection timeout must be an integer')
    if timeout < 1 or timeout > 120:
        raise ProbeFailure('Connection timeout must be between 1 and 120')

    helpers = require_mapping(config['remote_helpers'], 'remote_helpers')
    require_exact_keys(helpers, {'grid_probe'}, 'remote_helpers')
    validate_absolute_path(helpers['grid_probe'], 'grid probe')

    scheduler = require_mapping(config['scheduler'], 'scheduler')
    required = {'sacct_path', 'squeue_path', 'user'}
    require_exact_keys(scheduler, required, 'scheduler')
    validate_safe_name(scheduler['user'], 'scheduler user')
    validate_absolute_path(scheduler['squeue_path'], 'squeue path')
    validate_absolute_path(scheduler['sacct_path'], 'sacct path')
    return config


def load_config():
    """Load and validate the fixed shared remote configuration."""
    fpath = get_config_path()
    try:
        file_stat = fpath.lstat()
    except OSError as exc:
        raise ProbeFailure(f'Cannot inspect remote configuration: {exc}') from exc
    if stat.S_ISLNK(file_stat.st_mode) or not stat.S_ISREG(file_stat.st_mode):
        raise ProbeFailure('Remote configuration must be a regular file')
    try:
        with open(fpath, 'r') as fid:
            config = json.load(fid)
    except (OSError, json.JSONDecodeError) as exc:
        raise ProbeFailure(f'Cannot load remote configuration: {exc}') from exc
    return validate_config(config)


def config_identity(config):
    """Return the validated remote configuration digest."""
    return hash_bytes(canonical_json(config).encode())


def unknown_result(target, reason, details=None):
    """Build one structured unknown-state result."""
    result = {
        'schema_version': 1,
        'target': target,
        'status': 'unknown',
        'reason': reason,
    }
    if details:
        result['details'] = str(details)[:500]
    return result


def probe_lethe(config):
    """Check fixed automation-checkout visibility on lethe."""
    checkout = Path(config['git']['automation_checkout'])
    try:
        checkout_stat = checkout.lstat()
    except FileNotFoundError:
        return unknown_result('lethe', 'automation-checkout-missing')
    except OSError as exc:
        return unknown_result('lethe', 'checkout-unavailable', exc)
    if stat.S_ISLNK(checkout_stat.st_mode):
        return unknown_result('lethe', 'automation-checkout-is-symlink')
    if not stat.S_ISDIR(checkout_stat.st_mode):
        return unknown_result('lethe', 'automation-checkout-is-not-directory')

    git_marker = checkout / '.git'
    if not git_marker.exists():
        return unknown_result('lethe', 'git-marker-missing')
    return {
        'schema_version': 1,
        'target': 'lethe',
        'status': 'ok',
        'remote_host': socket.gethostname(),
        'automation_checkout': checkout.as_posix(),
        'checkout_visible': True,
        'helper': helper_identity(),
        'remote_config_sha256': config_identity(config),
    }


def decode_bounded(value, label):
    """Decode one bounded UTF-8 subprocess stream."""
    if len(value) > MAX_REMOTE_BYTES:
        raise ProbeFailure(f'{label} exceeded {MAX_REMOTE_BYTES} bytes')
    try:
        return value.decode('utf-8')
    except UnicodeDecodeError as exc:
        raise ProbeFailure(f'{label} was not valid UTF-8') from exc


def probe_grid(config):
    """Invoke the one fixed grid-side probe through its SSH alias."""
    helper_path = config['remote_helpers']['grid_probe']
    remote_command = ' '.join((shlex.quote(helper_path), 'probe'))
    timeout = config['ssh']['connect_timeout_sec']
    command = [
        SSH_PATH,
        '-o',
        'BatchMode=yes',
        '-o',
        f'ConnectTimeout={timeout}',
        '-o',
        'ConnectionAttempts=1',
        '--',
        config['ssh']['grid_host_alias'],
        remote_command,
    ]
    try:
        completed = subprocess.run(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout + 10,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return unknown_result('grid', 'connection-timeout')
    except OSError as exc:
        return unknown_result('grid', 'ssh-unavailable', exc)

    try:
        stdout = decode_bounded(completed.stdout, 'Grid stdout')
        stderr = decode_bounded(completed.stderr, 'Grid stderr')
        result = json.loads(stdout)
    except (ProbeFailure, json.JSONDecodeError) as exc:
        return unknown_result('grid', 'invalid-grid-output', exc)
    if not isinstance(result, dict) or result.get('status') not in {'ok', 'unknown'}:
        return unknown_result('grid', 'invalid-grid-result')
    if completed.returncode not in {EXIT_SUCCESS, EXIT_UNKNOWN}:
        details = stderr.replace('\r', ' ').replace('\n', ' ').strip()[:500]
        return unknown_result('grid', 'grid-helper-exit', details)

    result['via_lethe_host'] = socket.gethostname()
    result['lethe_helper'] = helper_identity()
    result['remote_config_sha256'] = config_identity(config)
    return result


def build_parser():
    """Build the fixed lethe-helper parser."""
    parser = argparse.ArgumentParser(
        description='Run fixed A1 lethe and grid probes.',
    )
    parser.add_argument('action', choices=('version', 'lethe', 'grid'))
    return parser


def main():
    """Run one fixed lethe-side probe operation."""
    parser = build_parser()
    try:
        args = parser.parse_args()
    except SystemExit as exc:
        return int(exc.code)

    try:
        if args.action == 'version':
            result = {'status': 'ok', 'helper': helper_identity()}
        else:
            config = load_config()
            result = (
                probe_lethe(config)
                if args.action == 'lethe'
                else probe_grid(config)
            )
    except ProbeFailure as exc:
        result = unknown_result(args.action, 'helper-failure', exc)
        print(json.dumps(result, sort_keys=True))
        return EXIT_UNKNOWN

    print(json.dumps(result, sort_keys=True))
    return EXIT_SUCCESS if result['status'] == 'ok' else EXIT_UNKNOWN


if __name__ == '__main__':
    raise SystemExit(main())
